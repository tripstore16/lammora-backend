rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /photos/{photoId} {
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    match /captures/{captureId} {
      allow read, write: if false;
    }

    match /pairings/{pairingId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
